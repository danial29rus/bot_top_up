# Required
BOT_TOKEN=123456:replace_me
RESELL_API_KEY=rsc_live_replace_me

# Persisted Docker volume location
DATABASE_PATH=/data/bot.sqlite3

# No payment provider is connected yet. Leave false until a real payment flow is implemented.
PAYMENT_ENABLED=false

# Storefront settings
# Retail price = supplier quote in USD × official USD/RUB × 1.10.
PRICE_MARKUP_PERCENT=10
RUB_PRICE_ROUNDING=10
ORDER_POLL_SECONDS=20

# The bot has built-in support; an external support account is not required.
# Before public payments, provide truthful owner/contact details where required by law.
OPERATOR_NAME=Владелец сервиса NovaTop
POLICY_REVISION=30.06.2026
DATA_RETENTION_DAYS=365

# Optional banner paths. The Docker image already contains these generated assets.
TOPUP_BANNER_PATH=/app/assets/topup-banner.png
CABINET_BANNER_PATH=/app/assets/cabinet-banner.png
